# ============================================================
# GAZELLE.IO — Environment Variables
# ============================================================
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
#
# Every key below is REQUIRED. The app validates these at startup
# via Zod and fails fast with a clear error if any is missing.
#
# NEVER commit `.env.local` or real keys/tokens.
# The SUPABASE_SERVICE_ROLE_KEY is server-side ONLY — it must never
# appear in iOS or browser/client code.
# ============================================================

# ---- Supabase (Next.js / Vercel — server + client) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic (agent LLM backbone) ----
ANTHROPIC_API_KEY=

# ---- Voyage AI (RAG embeddings — voyage-3.5, 1024 dims) ----
# Supersedes the spec's "Anthropic embeddings API" (which does not exist).
VOYAGE_API_KEY=

# ---- Apify (curriculum scraping — post-MVP, approved sources only) ----
APIFY_API_KEY=

# ============================================================
# iOS (Xcode) — set these in Config.xcconfig / Xcode Secrets,
# NOT in this file. Listed here for reference only.
#   SUPABASE_URL=          (same as NEXT_PUBLIC_SUPABASE_URL)
#   SUPABASE_ANON_KEY=     (anon key ONLY — never the service role key)
# ============================================================
